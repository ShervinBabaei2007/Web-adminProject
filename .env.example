PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/linklocker

# Google OAuth 2.0 (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must exactly match an "Authorized redirect URI" in the Google Cloud console
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Long random string used to sign session cookies (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
SESSION_SECRET=change-me
# Set to "production" on the server (enables Secure cookies; requires HTTPS)
NODE_ENV=development
